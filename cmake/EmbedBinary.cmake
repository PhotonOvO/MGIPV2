if(NOT DEFINED INPUT_FILE OR NOT DEFINED OUTPUT_FILE OR NOT DEFINED VARIABLE_NAME)
  message(FATAL_ERROR "EmbedBinary.cmake requires INPUT_FILE, OUTPUT_FILE, and VARIABLE_NAME")
endif()

file(READ "${INPUT_FILE}" _binary_hex HEX)
string(LENGTH "${_binary_hex}" _binary_hex_length)
math(EXPR _binary_size "${_binary_hex_length} / 2")

set(_header "#pragma once\n\n#include <cstddef>\n#include <cstdint>\n\n")
string(APPEND _header "inline constexpr uint8_t ${VARIABLE_NAME}[] = {\n")
if(_binary_hex_length GREATER 0)
  math(EXPR _last_byte_offset "${_binary_hex_length} - 2")
  set(_column 0)
  foreach(_offset RANGE 0 ${_last_byte_offset} 2)
    string(SUBSTRING "${_binary_hex}" ${_offset} 2 _byte)
    if(_column EQUAL 0)
      string(APPEND _header "  ")
    endif()
    string(APPEND _header "0x${_byte}u, ")
    math(EXPR _column "${_column} + 1")
    if(_column EQUAL 16)
      string(APPEND _header "\n")
      set(_column 0)
    endif()
  endforeach()
  if(NOT _column EQUAL 0)
    string(APPEND _header "\n")
  endif()
endif()
string(APPEND _header "};\n")
string(APPEND _header
  "inline constexpr size_t ${VARIABLE_NAME}_sizeInBytes = ${_binary_size}u;\n")
file(WRITE "${OUTPUT_FILE}" "${_header}")
