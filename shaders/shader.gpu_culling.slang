#include "shader_io.h"

[[vk::binding(0, 0)]]
StructuredBuffer<GPUCullObject> gpuCullObjects;

[[vk::binding(1, 0)]]
RWStructuredBuffer<GPUCullIndirectCommand> indirectCommands;

[[vk::binding(2, 0)]]
RWStructuredBuffer<GPUCullStats> cullStats;

[[vk::binding(3, 0)]]
RWStructuredBuffer<uint> cullResults;

[[vk::binding(4, 0)]]
RWStructuredBuffer<GPUCullDrawCounts> drawCounts;

[[vk::binding(5, 0)]]
Texture2D<float> depthPyramidTexture[LDepthPyramidMaxMips];

[[vk::binding(6, 0)]]
ConstantBuffer<GPUCullingUniforms> gpuCullingUniforms;

[[vk::binding(7, 0)]]
StructuredBuffer<Meshlet> meshlets;

static const uint kDepthPyramidGeneratedMipCount = 5u;
static const int kMaxHiZSamplesPerAxis = 8;
static const float kHiZPixelBoundaryEpsilon = 1.0e-4;
static const float kHiZClipBoundaryEpsilon = 1.0e-5;
static const float kMeshletConeSimilarityRelativeTolerance = 1.0e-6;
static const float kMeshletConeSimilarityCutoffSlack = 1.0e-3;

[[vk::binding(8, 0)]]
StructuredBuffer<GPUSceneObject> sceneObjects;

bool isInsideFrustum(float3 center, float radius)
{
    const float conservativeRadius = radius * 1.05 + 0.05;
    for(uint planeIndex = 0; planeIndex < uint(LGPUCullingFrustumPlaneCount); ++planeIndex)
    {
        float4 plane = gpuCullingUniforms.frustumPlanes[planeIndex];
        float distanceToPlane = dot(plane.xyz, center) + plane.w;
        if(distanceToPlane < -conservativeRadius)
        {
            return false;
        }
    }
    return true;
}

bool trySelectConservativeMip(float2 pixelMin,
                              float2 pixelMax,
                              float2 screenSize,
                              float2 pyramidSize,
                              uint mipCount,
                              out uint mipLevel,
                              out int2 sampleMin,
                              out int2 sampleMax)
{
    mipLevel = 0u;
    sampleMin = int2(0, 0);
    sampleMax = int2(-1, -1);

    const uint usableMipCount = min(mipCount, kDepthPyramidGeneratedMipCount);
    if(usableMipCount == 0u
       || any(screenSize <= float2(0.0, 0.0))
       || any(pyramidSize <= float2(0.0, 0.0)))
    {
        return false;
    }

    // Treat pixelMax as the exclusive edge of the projected rectangle.  The
    // guard band added by the caller already absorbs small projection errors.
    const float2 inclusiveMaxPixel =
        max(pixelMin, pixelMax - float2(kHiZPixelBoundaryEpsilon, kHiZPixelBoundaryEpsilon));

    // Pick the finest generated mip whose complete texel rectangle has a
    // bounded sampling cost. Every overlapped texel will be sampled below.
    for(uint candidateMip = 0u; candidateMip < usableMipCount; ++candidateMip)
    {
        const float sourceTexelSize = exp2(float(candidateMip + 1u));
        const int2 mipExtent = max(int2(1, 1), int2(pyramidSize) >> int(candidateMip));
        const float2 representedPixelMax =
            min(screenSize, float2(mipExtent) * sourceTexelSize);

        // Floor-sized Vulkan mips can omit a right/bottom strip when an input
        // dimension is odd. Never remap that strip onto unrelated depth.
        if(pixelMin.x < 0.0 || pixelMin.y < 0.0
           || pixelMax.x > representedPixelMax.x + kHiZPixelBoundaryEpsilon
           || pixelMax.y > representedPixelMax.y + kHiZPixelBoundaryEpsilon)
        {
            continue;
        }

        const int2 candidateMin = int2(floor(pixelMin / sourceTexelSize));
        const int2 candidateMax = int2(floor(inclusiveMaxPixel / sourceTexelSize));
        if(any(candidateMin < int2(0, 0)) || any(candidateMax >= mipExtent))
        {
            continue;
        }

        const int2 sampleSpan = candidateMax - candidateMin + int2(1, 1);
        if(sampleSpan.x <= kMaxHiZSamplesPerAxis && sampleSpan.y <= kMaxHiZSamplesPerAxis)
        {
            mipLevel = candidateMip;
            sampleMin = candidateMin;
            sampleMax = candidateMax;
            return true;
        }
    }

    return false;
}

float loadDepthPyramidMip(uint mipLevel, int2 coord)
{
    // Keep every descriptor-array index compile-time constant. mipLevel may
    // vary per invocation, but it only controls ordinary branches; this avoids
    // requiring sampled-image descriptor-array non-uniform indexing features.
    if(mipLevel == 0u)
    {
        return depthPyramidTexture[0].Load(int3(coord, 0));
    }
    if(mipLevel == 1u)
    {
        return depthPyramidTexture[1].Load(int3(coord, 0));
    }
    if(mipLevel == 2u)
    {
        return depthPyramidTexture[2].Load(int3(coord, 0));
    }
    if(mipLevel == 3u)
    {
        return depthPyramidTexture[3].Load(int3(coord, 0));
    }
    if(mipLevel == 4u)
    {
        return depthPyramidTexture[4].Load(int3(coord, 0));
    }

    // Only mip0..mip4 are generated by the one-dispatch pyramid pass.
    return 0.0;
}

float sampleHiZFootprintMinDepth(uint mipLevel, int2 sampleMin, int2 sampleMax)
{
    float conservativeDepth = 1.0;
    [loop]
    for(int y = sampleMin.y; y <= sampleMax.y; ++y)
    {
        [loop]
        for(int x = sampleMin.x; x <= sampleMax.x; ++x)
        {
            conservativeDepth =
                min(conservativeDepth, loadDepthPyramidMip(mipLevel, int2(x, y)));
        }
    }
    return conservativeDepth;
}

bool tryProjectConservativeSphereBounds(float3 centerView,
                                        float radius,
                                        out float2 minNdc,
                                        out float2 maxNdc,
                                        out float nearestDepth)
{
    minNdc = float2(1.0e30, 1.0e30);
    maxNdc = float2(-1.0e30, -1.0e30);
    nearestDepth = 0.0;

    // The view-space AABB contains the sphere. With clip.w positive over the
    // entire box, every x/w, y/w, and z/w extremum of this convex box occurs
    // at a corner, so projecting all eight corners is a conservative bound for
    // perspective (including off-axis/wide-FOV) and orthographic matrices.
    [unroll]
    for(uint cornerIndex = 0u; cornerIndex < 8u; ++cornerIndex)
    {
        const float3 cornerSign = float3(
            (cornerIndex & 1u) != 0u ? 1.0 : -1.0,
            (cornerIndex & 2u) != 0u ? 1.0 : -1.0,
            (cornerIndex & 4u) != 0u ? 1.0 : -1.0);
        const float3 cornerView = centerView + cornerSign * radius;
        const float4 cornerClip =
            mul(gpuCullingUniforms.projectionMatrix, float4(cornerView, 1.0));
        const float clipTolerance =
            kHiZClipBoundaryEpsilon * max(1.0, abs(cornerClip.w));

        // A box crossing the camera plane, near plane, or far plane does not
        // have one bounded screen-space projection. Keep it visible.
        if(cornerClip.w <= clipTolerance
           || cornerClip.z < -clipTolerance
           || cornerClip.z > cornerClip.w + clipTolerance)
        {
            return false;
        }

        const float3 cornerNdc = cornerClip.xyz / cornerClip.w;
        if(any(isnan(cornerNdc)) || any(isinf(cornerNdc)))
        {
            return false;
        }

        minNdc = min(minNdc, cornerNdc.xy);
        maxNdc = max(maxNdc, cornerNdc.xy);
        // Reverse-Z stores the nearest point at the largest depth. The AABB
        // maximum is an upper bound for every point in the enclosed sphere.
        nearestDepth = max(nearestDepth, saturate(cornerNdc.z));
    }

    return true;
}

bool isOccluded(float3 center, float radius)
{
    const float conservativeRadius = radius * 1.1 + 0.1;
    const float3 centerView = mul(gpuCullingUniforms.viewMatrix, float4(center, 1.0)).xyz;
    float2 minNdc;
    float2 maxNdc;
    float nearestDepth;
    if(!tryProjectConservativeSphereBounds(
           centerView, conservativeRadius, minNdc, maxNdc, nearestDepth))
    {
        InterlockedAdd(cullStats[0].hizRejectedNearCount, 1u);
        return false;
    }

    const float2 guardBandNdc = 2.0 / max(gpuCullingUniforms.screenSizeAndPyramidSize.xy, float2(1.0, 1.0));

    minNdc -= guardBandNdc;
    maxNdc += guardBandNdc;
    if(maxNdc.x < -1.0 || minNdc.x > 1.0 || maxNdc.y < -1.0 || minNdc.y > 1.0)
    {
        InterlockedAdd(cullStats[0].hizRejectedOffscreenCount, 1u);
        return false;
    }

    minNdc = clamp(minNdc, float2(-1.0, -1.0), float2(1.0, 1.0));
    maxNdc = clamp(maxNdc, float2(-1.0, -1.0), float2(1.0, 1.0));

    const float2 screenSize = gpuCullingUniforms.screenSizeAndPyramidSize.xy;
    const float2 pyramidSize = gpuCullingUniforms.screenSizeAndPyramidSize.zw;
    const uint mipCount = uint(gpuCullingUniforms.cullingInfo.y);

    const float2 minPixel = (minNdc * 0.5 + 0.5) * screenSize;
    const float2 maxPixel = (maxNdc * 0.5 + 0.5) * screenSize;
    uint mipLevel;
    int2 sampleMin;
    int2 sampleMax;
    if(!trySelectConservativeMip(minPixel,
                                 maxPixel,
                                 screenSize,
                                 pyramidSize,
                                 mipCount,
                                 mipLevel,
                                 sampleMin,
                                 sampleMax))
    {
        InterlockedAdd(cullStats[0].hizRejectedLargeCount, 1u);
        return false;
    }
    InterlockedAdd(cullStats[0].hizTestedCount, 1u);
    const float hizDepth = sampleHiZFootprintMinDepth(mipLevel, sampleMin, sampleMax);

    const float depthEpsilon = gpuCullingUniforms.cullingInfo.w;
    if(hizDepth <= depthEpsilon)
    {
        // Reverse-Z clear/empty depth is zero. Any empty sample means the
        // complete object footprint is not proven to be covered.
        return false;
    }

    return nearestDepth + depthEpsilon < hizDepth;
}

// 将 meshlet 局部包围球变换到世界空间：
//   worldCenter = M * localCenter（行主序矩阵点乘，w=1 含平移）
//   radiusScale = ||M3x3||_F >= ||M3x3||_2
// Frobenius 范数是任意非均匀缩放、父子旋转与 shear 下的安全上界。
float4 transformMeshletLocalBoundsSphere(uint sceneObjectIndex, float4 localSphere)
{
    const float4 row0 = sceneObjects[sceneObjectIndex].worldMatrixRows[0];
    const float4 row1 = sceneObjects[sceneObjectIndex].worldMatrixRows[1];
    const float4 row2 = sceneObjects[sceneObjectIndex].worldMatrixRows[2];

    const float4 localPos = float4(localSphere.xyz, 1.0);
    const float3 worldCenter = float3(dot(row0, localPos),
                                      dot(row1, localPos),
                                      dot(row2, localPos));

    const float frobeniusScale = sqrt(
        dot(row0.xyz, row0.xyz)
        + dot(row1.xyz, row1.xyz)
        + dot(row2.xyz, row2.xyz));

    return float4(worldCenter, max(localSphere.w * frobeniusScale, 0.0));
}

bool tryTransformMeshletConeAxis(uint objectIndex,
                                 float3 localAxis,
                                 out float3 worldAxis)
{
    worldAxis = float3(0.0, 0.0, 0.0);
    const GPUSceneObject sceneObject = sceneObjects[objectIndex];
    const float3 row0 = sceneObject.worldMatrixRows[0].xyz;
    const float3 row1 = sceneObject.worldMatrixRows[1].xyz;
    const float3 row2 = sceneObject.worldMatrixRows[2].xyz;
    if(any(isnan(row0)) || any(isinf(row0))
       || any(isnan(row1)) || any(isinf(row1))
       || any(isnan(row2)) || any(isinf(row2))
       || any(isnan(localAxis)) || any(isinf(localAxis)))
    {
        return false;
    }

    // A normal cone keeps its cutoff unchanged only under a similarity
    // transform. Reject non-uniform scale and shear instead of risking a false
    // backface cull. A small cutoff slack below covers accepted roundoff-sized
    // Gram-matrix deviations.
    const float rowLengthSq0 = dot(row0, row0);
    const float rowLengthSq1 = dot(row1, row1);
    const float rowLengthSq2 = dot(row2, row2);
    const float maxRowLengthSq = max(rowLengthSq0, max(rowLengthSq1, rowLengthSq2));
    const float minRowLengthSq = min(rowLengthSq0, min(rowLengthSq1, rowLengthSq2));
    if(isnan(maxRowLengthSq) || isinf(maxRowLengthSq) || minRowLengthSq <= 1.0e-10)
    {
        return false;
    }

    const float gramTolerance =
        maxRowLengthSq * kMeshletConeSimilarityRelativeTolerance;
    if(maxRowLengthSq - minRowLengthSq > gramTolerance
       || abs(dot(row0, row1)) > gramTolerance
       || abs(dot(row0, row2)) > gramTolerance
       || abs(dot(row1, row2)) > gramTolerance)
    {
        return false;
    }

    // Cofactor rows form determinant(A) * inverseTranspose(A). The raster
    // pipeline is fixed CCW with back-face culling and has no mirrored variant,
    // so a negative determinant changes winding parity. Conservatively disable
    // cone culling for mirrored or near-singular transforms; for a positive
    // determinant the normalized cofactor result has the inverse-transpose direction.
    const float3 cofactorRow0 = cross(row1, row2);
    const float3 cofactorRow1 = cross(row2, row0);
    const float3 cofactorRow2 = cross(row0, row1);
    const float determinant = dot(row0, cofactorRow0);
    const float determinantTolerance =
        maxRowLengthSq * sqrt(maxRowLengthSq) * 1.0e-6;
    if(isnan(determinant) || isinf(determinant)
       || determinant <= determinantTolerance)
    {
        return false;
    }

    const float3 inverseTransposeAxis =
        float3(dot(cofactorRow0, localAxis),
               dot(cofactorRow1, localAxis),
               dot(cofactorRow2, localAxis));
    const float axisLengthSq = dot(inverseTransposeAxis, inverseTransposeAxis);
    if(isnan(axisLengthSq) || isinf(axisLengthSq) || axisLengthSq <= 1.0e-10)
    {
        return false;
    }

    worldAxis = inverseTransposeAxis * rsqrt(axisLengthSq);
    return !(any(isnan(worldAxis)) || any(isinf(worldAxis)));
}

bool isMeshletConeCulled(uint meshletIndex, float3 center, float radius)
{
    if(gpuCullingUniforms.cullingControls.z <= 0.5 || gpuCullingUniforms.cullingControls.w <= 0.5)
    {
        return false;
    }

    const Meshlet meshlet = meshlets[meshletIndex];
    if(meshlet.objectIndex == 0xffffffffu)
    {
        return false;
    }

    const float3 localAxis = meshlet.coneAxisCutoff.xyz;
    const float coneCutoff = meshlet.coneAxisCutoff.w;
    if(dot(localAxis, localAxis) <= 1e-5 || coneCutoff <= -1.0 || coneCutoff >= 1.0)
    {
        return false;
    }

    float3 worldAxis;
    if(!tryTransformMeshletConeAxis(meshlet.objectIndex, localAxis, worldAxis))
    {
        return false;
    }

    const float3 cameraToCenter = center - gpuCullingUniforms.cameraPositionAndMeshletInfo.xyz;
    const float distanceToCamera = length(cameraToCenter);
    if(distanceToCamera <= max(radius * 2.0, 1e-4))
    {
        return false;
    }

    const float radiusSlack = min(0.15, radius / distanceToCamera);
    const float conservativeConeCutoff =
        min(1.0, coneCutoff + kMeshletConeSimilarityCutoffSlack);
    return dot(cameraToCenter / distanceToCamera, worldAxis)
        >= conservativeConeCutoff + radiusSlack;
}

[numthreads(LGPUCullingThreadCount, 1, 1)]
[shader("compute")]
void gpuCullingMain(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    const uint objectIndex = dispatchThreadId.x;
    const uint objectCount = uint(gpuCullingUniforms.cullingInfo.x);
    if(objectIndex >= objectCount)
    {
        return;
    }

    const bool useMeshletCulling = gpuCullingUniforms.cullingControls.z > 0.5;
    if(useMeshletCulling && meshlets[objectIndex].objectIndex == 0xffffffffu)
    {
        // Removed meshlet entries remain in the dense draw-address space until
        // a topology rebuild. Clear their raw command before any classification
        // or counter update so first-frame and recycled-buffer contents fail closed.
        GPUCullIndirectCommand tombstoneCommand;
#ifdef DEMO_D3D12
        tombstoneCommand.drawIndex = 0u;
#endif
        tombstoneCommand.indexCount = 0u;
        tombstoneCommand.instanceCount = 0u;
        tombstoneCommand.firstIndex = 0u;
        tombstoneCommand.vertexOffset = 0;
        tombstoneCommand.firstInstance = 0u;
        indirectCommands[objectIndex] = tombstoneCommand;
        // LGPUCullResultVisible is zero, so publish a non-visible diagnostic value.
        cullResults[objectIndex] = LGPUCullResultFrustumCulled;
        return;
    }

    InterlockedAdd(cullStats[0].totalCount, 1u);

    const GPUCullObject objectData = gpuCullObjects[objectIndex];
    const bool isTransparent = (objectData.flags & LGPUCullFlagTransparent) != 0u;
    if(isTransparent)
    {
        InterlockedAdd(cullStats[0].transparentCount, 1u);
    }
    else
    {
        InterlockedAdd(cullStats[0].opaqueCount, 1u);
    }

    GPUCullIndirectCommand command;
#ifdef DEMO_D3D12
    command.drawIndex = objectIndex;
#endif
    command.indexCount = objectData.indexCount;
    command.instanceCount = 0u;
    command.firstIndex = objectData.firstIndex;
    command.vertexOffset = objectData.vertexOffset;
    command.firstInstance = objectIndex;

    float3 center;
    float radius;
    if(useMeshletCulling)
    {
        // meshlet 模式：用 meshlet 局部包围球 + 世界矩阵实时变换，忽略 objectData 中的预计算世界球
        const Meshlet meshlet = meshlets[objectIndex];
        const float4 worldSphere = transformMeshletLocalBoundsSphere(meshlet.objectIndex, meshlet.boundsSphere);
        center = worldSphere.xyz;
        radius = max(worldSphere.w, 0.0);
    }
    else
    {
        // object-level 模式：保持原有行为，直接用预计算世界球
        center = objectData.sphereCenterRadius.xyz;
        radius = max(objectData.sphereCenterRadius.w, 0.0);
    }

    const bool enableFrustumCulling = (objectData.flags & LGPUCullFlagFrustumCulling) != 0u
                                      && gpuCullingUniforms.cullingControls.x > 0.5;
    const bool enableOcclusionCulling = (objectData.flags & LGPUCullFlagOcclusionCulling) != 0u
                                        && gpuCullingUniforms.cullingControls.y > 0.5;

    if(enableFrustumCulling && !isInsideFrustum(center, radius))
    {
        InterlockedAdd(cullStats[0].frustumCulledCount, 1u);
        cullResults[objectIndex] = LGPUCullResultFrustumCulled;
        indirectCommands[objectIndex] = command;
        return;
    }

    if(isMeshletConeCulled(objectIndex, center, radius))
    {
        InterlockedAdd(cullStats[0].meshletConeCulledCount, 1u);
        cullResults[objectIndex] = LGPUCullResultConeCulled;
        indirectCommands[objectIndex] = command;
        return;
    }

    const bool useOcclusion = gpuCullingUniforms.cullingInfo.z > 0.5;
    if(enableOcclusionCulling && useOcclusion)
    {
        InterlockedAdd(cullStats[0].hizCandidateCount, 1u);
        if(isOccluded(center, radius))
        {
            InterlockedAdd(cullStats[0].occlusionCulledCount, 1u);
            cullResults[objectIndex] = LGPUCullResultOcclusionCulled;
            indirectCommands[objectIndex] = command;
            return;
        }
    }

    command.instanceCount = 1u;
    InterlockedAdd(cullStats[0].visibleCount, 1u);
    uint compactIndex = 0u;
    if(isTransparent)
    {
        InterlockedAdd(cullStats[0].transparentVisibleCount, 1u);
        InterlockedAdd(drawCounts[0].transparentCount, 1u, compactIndex);
        compactIndex += objectCount * 3u;
    }
    else if((objectData.flags & LGPUCullFlagAlphaMask) != 0u)
    {
        InterlockedAdd(drawCounts[0].alphaTestCount, 1u, compactIndex);
        compactIndex += objectCount * 2u;
    }
    else
    {
        InterlockedAdd(cullStats[0].opaqueVisibleCount, 1u);
        InterlockedAdd(drawCounts[0].opaqueCount, 1u, compactIndex);
        compactIndex += objectCount;
    }
    InterlockedAdd(drawCounts[0].totalCount, 1u);
    cullResults[objectIndex] = LGPUCullResultVisible;
    indirectCommands[objectIndex] = command;
    indirectCommands[compactIndex] = command;
}
